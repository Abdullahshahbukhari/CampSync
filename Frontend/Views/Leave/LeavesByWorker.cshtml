@model List<Frontend.DTOs.LeaveResponseModel>
@{
    ViewData["Title"] = "Worker Leave History"; var workerId = (int?)ViewBag.WorkerId ?? 0; var role = Context.Session.GetString("role") ?? "";
}
<div class="container-fluid py-4 leave-page">
    <div class="leave-header mb-4"><div><span class="section-badge">@role ONLY</span><h1 class="mt-2 mb-1">Worker Leave History</h1><p class="text-muted mb-0">Complete leave history for Worker #@workerId.</p></div><div class="d-flex gap-2"><a asp-action="LeaveHub" class="btn btn-outline-secondary">Back</a><a asp-action="Summary" asp-route-workerId="@workerId" class="btn btn-leave-primary">Summary</a></div></div>
    <div class="leave-main-card">
        @if (Model?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>#</th><th>User</th><th>From</th><th>To</th><th>Reason</th><th>Status</th><th>Approved/Rejected By</th><th>Rejection Reason</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr><td>#@item.Id</td><td>@item.UserName</td><td>@item.FromDate.ToString("dd MMM yyyy")</td><td>@item.ToDate.ToString("dd MMM yyyy")</td><td>@item.Reason</td><td><span class="status @(item.Status == "Approved" ? "approved" : item.Status == "Rejected" ? "rejected" : "pending")">@item.Status</span></td><td>@(item.ApprovedByName ?? "—")</td><td>@(item.RejectionReason ?? "—")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {

            <div class="empty-state"><h4>No leave history found</h4><p>No leave request exists for Worker #@workerId.</p></div>
        }
    </div>
</div>
<style>
    .leave-page {
        max-width: 1500px;
        margin: auto
    }

    .leave-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 30px;
        border-radius: 24px;
        background: linear-gradient(135deg,#fff,#fff4ec);
        box-shadow: 0 12px 40px rgba(0,0,0,.05)
    }

    .section-badge {
        color: #ff6b1a;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px
    }

    .leave-header h1 {
        font-weight: 750
    }

    .leave-main-card {
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,.06)
    }

    table th {
        font-size: 11px;
        text-transform: uppercase;
        color: #777;
        background: #fff8f4;
        border: 0;
        padding: 16px
    }

    table td {
        padding: 16px;
        border-color: #f1f1f1
    }

    .status {
        display: inline-flex;
        padding: 7px 11px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700
    }

    .pending {
        background: #fff5df;
        color: #c77700
    }

    .approved {
        background: #eaf8ef;
        color: #198754
    }

    .rejected {
        background: #ffebeb;
        color: #dc3545
    }

    .btn-leave-primary {
        background: #ff6b1a;
        color: #fff;
        border: 0;
        border-radius: 11px;
        font-weight: 700
    }

    .empty-state {
        text-align: center;
        padding: 70px 25px
    }

    @@media(max-width:768px) {
        .leave-header {
            flex-direction: column;
            align-items: flex-start
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>
