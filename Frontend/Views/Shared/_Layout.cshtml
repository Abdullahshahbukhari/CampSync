<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CampSync</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Frontend.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg camp-navbar mb-4">

            <div class="container-fluid px-4">

            

                <a class="navbar-brand camp-brand"
                   asp-controller="Home"
                   asp-action="Welcome">

                    <span class="brand-mark">
                        <i class="bi bi-buildings-fill"></i>
                    </span>

                    CampSync

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false">

                    <span class="camp-toggler-icon" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                </button>


                @{
                    var role = Context.Session.GetString("role") ?? "";

                    var loggedIn =
                        User.Identity?.IsAuthenticated == true &&
                        !string.IsNullOrWhiteSpace(
                            Context.Session.GetString("token"));

                    var isAdmin =
                        role.Equals(
                            "Admin",
                            StringComparison.OrdinalIgnoreCase);

                    var isSupervisor =
                        role.Equals(
                            "Supervisor",
                            StringComparison.OrdinalIgnoreCase);

                    var isWorker =
                        role.Equals(
                            "Worker",
                            StringComparison.OrdinalIgnoreCase);

                    var isDriver =
                        role.Equals(
                            "Driver",
                            StringComparison.OrdinalIgnoreCase);
                }


                <div class="collapse navbar-collapse"
                     id="mainNav">

                    @if (loggedIn)
                    {

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Welcome">

                                    <i class="bi bi-house-door me-1"></i>

                                    Home

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Profile"
                                   asp-action="MyProfile">

                                    <i class="bi bi-person-vcard me-1"></i>

                                    My Profile

                                </a>

                            </li>

                            @if (isAdmin || isSupervisor)
                            {


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Camp"
                                       asp-action="CampList">

                                        Camps

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Room"
                                       asp-action="RoomList">

                                        Rooms

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Bed"
                                       asp-action="BedList">

                                        Beds

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Bus"
                                       asp-action="BusList">

                                        Buses

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Worker"
                                       asp-action="WorkerList">

                                        Workers

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Attendance"
                                       asp-action="AttendanceList">

                                        Attendance

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="RouteStop"
                                       asp-action="RouteStopList">

                                        Routes

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="LeaveHub">

                                        Leaves

                                    </a>

                                </li>

                            }

                            @if (isAdmin)
                            {


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="User"
                                       asp-action="CreateUser">

                                        <i class="bi bi-person-plus me-1"></i>

                                        Create User

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Report"
                                       asp-action="Dashboard">

                                        <i class="bi bi-bar-chart-line me-1"></i>

                                        Reports

                                    </a>

                                </li>

                            }

                            @if (isDriver || isWorker)
                            {


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Bus"
                                       asp-action="MyBus">

                                        <i class="bi bi-bus-front me-1"></i>

                                        My Bus

                                    </a>

                                </li>

                            }

                            @if (isDriver)
                            {

                            }


                            @if (isWorker)
                            {

                              

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Attendance"
                                       asp-action="MyAttendance">

                                        <i class="bi bi-calendar-check me-1"></i>

                                        My Attendance

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="MyLeaves">

                                        <i class="bi bi-calendar2-week me-1"></i>

                                        My Leaves

                                    </a>

                                </li>

                            }

                            @if (isDriver)
                            {

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Attendance"
                                       asp-action="MyAttendance">

                                        <i class="bi bi-calendar-check me-1"></i>

                                        My Attendance

                                    </a>

                                </li>

                            }

                        </ul>


                        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">

                            <span class="user-chip">

                                <i class="bi bi-person-circle me-1"></i>

                                @User.Identity?.Name

                                <span class="role-badge">
                                    @role
                                </span>

                            </span>

                            <a class="logout-btn"
                               asp-controller="Auth"
                               asp-action="Logout">

                                <i class="bi bi-box-arrow-right me-1"></i>

                                Logout

                            </a>

                        </div>

                    }
                    else
                    {


                        <div class="ms-auto">

                            <a class="btn-camp-primary"
                               asp-controller="Auth"
                               asp-action="Login">

                                <i class="bi bi-box-arrow-in-right me-1"></i>

                                Login

                            </a>

                        </div>

                    }

                </div>

            </div>

        </nav>

    </header>


    <div class="container-fluid">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <footer class="border-top footer text-muted mt-4">

        <div class="container">

            &copy; 2026 - CampSync

        </div>

    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)


    <style>

            body {
                background: #fff7f1;
            }

            .camp-navbar {
                background: #fff;
                border-bottom: 1px solid #f1e6df;
                box-shadow: 0 8px 28px rgba(0,0,0,.05);
            }

            .camp-brand {
                color: #212529 !important;
                font-weight: 700;
                font-size: 21px;
                display: flex;
                align-items: center;
                gap: 9px;
            }


            .brand-mark {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: linear-gradient( 135deg, #ff6b1a, #ff9a5a );
                color: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 6px 15px rgba(255,107,26,.2);
            }

            .camp-navbar .nav-link {
                color: #555;
                font-weight: 600;
                border-radius: 10px;
                padding: 9px 11px !important;
                transition: .2s;
            }


                .camp-navbar .nav-link:hover {
                    color: #ff6b1a;
                    background: #fff4ec;
                }



            .user-chip {
                color: #555;
                font-size: 14px;
                font-weight: 600;
            }


            .role-badge {
                background: #fff0e7;
                color: #ff6b1a;
                padding: 5px 9px;
                border-radius: 9px;
                font-size: 11px;
                margin-left: 4px;
            }


            .logout-btn {
                text-decoration: none;
                color: #dc3545;
                border: 1px solid #f2c9ce;
                padding: 8px 13px;
                border-radius: 11px;
                font-weight: 600;
                transition: .2s;
            }


                .logout-btn:hover {
                    color: #fff;
                    background: #dc3545;
                }


            .btn-camp-primary {
                display: inline-flex;
                align-items: center;
                text-decoration: none;
                background: linear-gradient( 135deg, #ff6b1a, #ff944d );
                color: #fff !important;
                border: none;
                padding: 10px 18px;
                border-radius: 12px;
                font-weight: 600;
                box-shadow: 0 7px 18px rgba(255,107,26,.2);
                transition: .25s;
            }


                .btn-camp-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 22px rgba(255,107,26,.3);
                }

            .camp-navbar .navbar-toggler {
                display: none;
                border: 1px solid #f0d9cc;
                background: #fff7f1;
                box-shadow: none;
                outline: none;
            }

            .camp-toggler-icon {
                width: 24px;
                height: 20px;
                display: inline-flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .camp-toggler-icon span {
                    display: block;
                    width: 100%;
                    height: 2px;
                    border-radius: 2px;
                    background: #ff6b1a;
                }

            .camp-navbar .navbar-toggler:focus {
                box-shadow: 0 0 0 .2rem rgba(255,107,26,.12);
            }

            @@media (max-width: 991.98px) {
                .camp-navbar .navbar-toggler {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }
            }


            html {
                overflow-x: hidden;
            }

            body {
                overflow-x: hidden;
            }

            .table-responsive {
                width: 100%;
                max-width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: thin;
            }

                .table-responsive > .table {
                    margin-bottom: 0;
                }

            img,
            svg,
            video,
            canvas {
                max-width: 100%;
            }

            input,
            select,
            textarea,
            button {
                max-width: 100%;
            }

            .text-break,
            td,
            th {
                overflow-wrap: anywhere;
            }

            @@media (max-width: 991.98px) {
                .container-fluid.px-4 {
                    padding-left: 1rem !important;
                    padding-right: 1rem !important;
                }

                .camp-navbar .navbar-collapse {
                    padding-top: .5rem;
                    padding-bottom: .5rem;
                }

                .camp-navbar .navbar-nav {
                    width: 100%;
                }

                .camp-navbar .nav-link {
                    display: block;
                }

                .camp-navbar .navbar-toggler {
                    padding: .45rem .65rem;
                    border-radius: 10px;
                }

                .camp-navbar .navbar-collapse > .d-flex {
                    align-items: stretch !important;
                    flex-direction: column;
                    gap: .5rem !important;
                    width: 100%;
                }

                    .camp-navbar .navbar-collapse > .d-flex .logout-btn,
                    .camp-navbar .navbar-collapse > .d-flex .user-chip {
                        width: 100%;
                    }

                    .camp-navbar .navbar-collapse > .d-flex .logout-btn {
                        text-align: center;
                    }
            }

            @@media (max-width: 767.98px) {
                .container,
                .container-fluid {
                    --bs-gutter-x: 1rem;
                }

                .py-5 {
                    padding-top: 2rem !important;
                    padding-bottom: 2rem !important;
                }

                h1 {
                    font-size: clamp(1.65rem, 6vw, 2.25rem);
                }

                h2 {
                    font-size: clamp(1.4rem, 5vw, 1.9rem);
                }

                .card-body {
                    overflow-wrap: anywhere;
                }

                .table-responsive > .table {
                    min-width: 640px;
                }
                
                .form-control,
                .form-select,
                .input-group-text {
                    min-height: 48px;
                }

                .d-flex.flex-column.flex-sm-row {
                    width: 100%;
                }

                    .d-flex.flex-column.flex-sm-row > .btn,
                    .d-flex.flex-column.flex-sm-row > a.btn {
                        width: 100%;
                    }
            }

            @@media (max-width: 575.98px) {
                .container-fluid.px-4 {
                    padding-left: .75rem !important;
                    padding-right: .75rem !important;
                }

                .camp-brand {
                    font-size: 18px;
                }

                .brand-mark {
                    width: 34px;
                    height: 34px;
                }

                .create-camp-card,
                .card {
                    border-radius: 20px;
                }

                .card-body {
                    padding: 1.25rem !important;
                }

                .table-responsive > .table {
                    min-width: 600px;
                }
            }

            @@media (max-width: 991px) {

                .camp-navbar .navbar-nav {
                    padding-top: 10px;
                    padding-bottom: 10px;
                }


                .camp-navbar .nav-link {
                    margin-bottom: 3px;
                }


                .user-chip {
                    display: inline-block;
                    margin-bottom: 8px;
                }
            }

    </style>


    <style>
           
            html {
                overflow-x: hidden;
            }

            body {
                overflow-x: hidden;
            }

            img,
            svg,
            video,
            canvas {
                max-width: 100%;
                height: auto;
            }

            .container,
            .container-fluid {
                width: 100%;
            }

            .card,
            .shadow-sm,
            .shadow {
                max-width: 100%;
            }

            .form-control,
            .form-select,
            textarea,
            input {
                max-width: 100%;
            }

            .btn {
                white-space: normal;
            }

            .table-responsive {
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

                .table-responsive > .table {
                    margin-bottom: 0;
                }

            @@media (max-width: 767.98px) {
                .table:not(.table-responsive .table) {
                    min-width: 680px;
                }

                .table-responsive {
                    margin-left: 0;
                    margin-right: 0;
                }

                .display-1,
                .display-2,
                .display-3,
                .display-4 {
                    font-size: calc(1.5rem + 2vw);
                }

                h1 {
                    font-size: 1.75rem;
                }

                h2 {
                    font-size: 1.5rem;
                }

                h3 {
                    font-size: 1.25rem;
                }

                .row {
                    --bs-gutter-x: 1rem;
                }

                .card-body {
                    padding-left: 1rem !important;
                    padding-right: 1rem !important;
                }

                .input-group {
                    width: 100%;
                }

                    .input-group .form-control,
                    .input-group .form-select {
                        min-width: 0;
                    }

                .d-flex.gap-3 {
                    gap: .75rem !important;
                }

                .btn {
                    min-height: 44px;
                }
            }

            @@media (max-width: 575.98px) {
                .container,
                .container-fluid {
                    padding-left: 12px !important;
                    padding-right: 12px !important;
                }

                .card-body {
                    padding: 1rem !important;
                }

                .form-control,
                .form-select {
                    min-height: 46px;
                }

                .btn {
                    width: 100%;
                }
               
                .d-flex.flex-row {
                    flex-wrap: wrap;
                }

                .alert {
                    overflow-wrap: anywhere;
                }

                .modal-dialog {
                    margin: .5rem;
                }
            }
    </style>

</body>
</html>