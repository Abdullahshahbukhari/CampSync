@model List<Frontend.DTOs.AttendanceResponseModel>

@{
    ViewData["Title"] = "Attendance Management";
    var role = Context.Session.GetString("role") ?? "";
    var selectedDate =
        ViewBag.SelectedDate as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    var selectedCampId =
        ViewBag.SelectedCampId?.ToString() ?? "";

    var totalRecords = Model?.Count ?? 0;

    var totalPresent =
        Model?.Count(x => x.Status == "Present") ?? 0;

    var totalAbsent =
        Model?.Count(x => x.Status == "Absent") ?? 0;

    var totalLeave =
        Model?.Count(x => x.Status == "Leave") ?? 0;
}


<div class="container-fluid py-4">
    <div class="attendance-header mb-4">
        <div>
            <span class="section-badge">ATTENDANCE MANAGEMENT</span>
            <h1 class="mt-2 mb-1">Attendance Records</h1>
            <p class="text-muted mb-0">View, manage and update worker attendance records.</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Supervisor"))
        {
            <a asp-action="MarkAttendance"class="btn btn-attendance-primary mt-3 mt-md-0">
                <i class="bi bi-person-check-fill me-2"></i>
                Mark Attendance
            </a>
        }

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"class="btn-close"data-bs-dismiss="alert"></button>

        </div>
    }


    @if (role == "Supervisor")
    {
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <i class="bi bi-shield-check me-2"></i>
            Supervisor attendance is limited to workers in your assigned camp.
        </div>
    }

    <div class="card attendance-filter-card border-0 mb-4">

        <div class="card-body p-4">

            <form asp-action="AttendanceList" method="get">

                <div class="row align-items-end g-3">


                    <div class="col-lg-3 col-md-6">

                        <label class="filter-label">

                            <i class="bi bi-calendar-date"></i>

                            Attendance Date

                        </label>

                        <input type="date"
                               name="atDate"
                               value="@selectedDate"
                               class="form-control custom-input" />

                    </div>


                    <div class="col-lg-3 col-md-6">

                        <label class="filter-label">

                            <i class="bi bi-search"></i>

                            Search By

                        </label>

                        <select name="searchType"
                                id="searchType"
                                class="form-select custom-input">

                            <option value="camp"
                                    selected="@(ViewBag.SearchType == "camp")">

                                By Camp

                            </option>

                            <option value="worker"
                                    selected="@(ViewBag.SearchType == "worker")">

                                By Worker ID

                            </option>

                        </select>

                    </div>



                    <div class="col-lg-4 col-md-6"
                         id="campSearchBox">

                        <label class="filter-label">

                            <i class="bi bi-buildings"></i>

                            @(role == "Supervisor" ? "My Camp" : "Select Camp")

                        </label>

                        <select name="campId"
                                id="campFilter"
                                class="form-select custom-input">

                            @if (role != "Supervisor")
                            {
                                <option value="">
                                    All Camps
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-lg-4 col-md-6"
                         id="workerSearchBox"
                         style="display:none;">

                        <label class="filter-label">

                            <i class="bi bi-person-badge"></i>

                            Worker ID

                        </label>

                        <input type="number"
                               name="workerId"
                               value="@ViewBag.WorkerId"
                               class="form-control custom-input"
                               placeholder="Enter Worker ID" />

                    </div>



                    <div class="col-lg-2 col-md-6">

                        <button type="submit"
                                class="btn btn-attendance-primary w-100">

                            <i class="bi bi-search me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>




    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="attendance-stat-card">

                <div class="stat-icon total-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

                <div>

                    <span>
                        Total Records
                    </span>

                    <h3>
                        @totalRecords
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="attendance-stat-card">

                <div class="stat-icon present-icon">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

                <div>

                    <span>
                        Present
                    </span>

                    <h3>
                        @totalPresent
                    </h3>

                </div>

            </div>

        </div>



        <div class="col-xl-3 col-md-6">

            <div class="attendance-stat-card">

                <div class="stat-icon absent-icon">

                    <i class="bi bi-x-circle-fill"></i>

                </div>

                <div>

                    <span>
                        Absent
                    </span>

                    <h3>
                        @totalAbsent
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="attendance-stat-card">

                <div class="stat-icon leave-icon">

                    <i class="bi bi-calendar-event-fill"></i>

                </div>

                <div>

                    <span>
                        On Leave
                    </span>

                    <h3>
                        @totalLeave
                    </h3>

                </div>

            </div>

        </div>


    </div>



    <div class="card attendance-main-card border-0">

        <div class="card-body p-0">


            <div class="attendance-table-header p-4">

                <div>

                    <h4 class="mb-1 fw-bold">

                        <i class="bi bi-list-check me-2"></i>

                        Attendance List

                    </h4>

                    <p class="text-muted mb-0">

                        Records for

                        <strong>
                            @selectedDate
                        </strong>

                    </p>

                </div>


                <div class="record-count">

                    <i class="bi bi-clipboard-check me-1"></i>

                    @totalRecords Records

                </div>

            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger m-4 mb-0">

                    <i class="bi bi-exclamation-circle-fill me-2"></i>

                    @ViewBag.Error

                </div>
            }



            @if (Model != null && Model.Any())
            {

                <div class="table-responsive">

                    <table class="table attendance-table mb-0">


                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Worker
                                </th>

                                <th>
                                    Attendance Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Marked By
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>




                        <tbody>

                            @foreach (var item in Model)
                            {

                                <tr>


                                    <td>

                                        <span class="attendance-id">

                                            #@item.Id

                                        </span>

                                    </td>

                                    <td>

                                        <div class="worker-info">

                                            <div class="worker-avatar">

                                                <i class="bi bi-person-fill"></i>

                                            </div>


                                            <div>

                                                <strong>

                                                    @item.WorkerName

                                                </strong>


                                                <small>

                                                    Worker ID: @item.WorkerId

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <div class="date-info">

                                            <i class="bi bi-calendar3"></i>

                                            @item.AtDate.ToString("dd MMM yyyy")

                                        </div>

                                    </td>

                                    <td>

                                        @if (item.Status == "Present")
                                        {
                                            <span class="attendance-status status-present">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Present

                                            </span>
                                        }
                                        else if (item.Status == "Absent")
                                        {
                                            <span class="attendance-status status-absent">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Absent

                                            </span>
                                        }
                                        else if (item.Status == "Leave")
                                        {
                                            <span class="attendance-status status-leave">

                                                <i class="bi bi-calendar-event-fill"></i>

                                                Leave

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="attendance-status status-other">

                                                @item.Status

                                            </span>
                                        }

                                    </td>



                                    <td>

                                        <div class="marked-by">

                                            <i class="bi bi-person-check-fill"></i>

                                            @item.MarkedBy

                                        </div>

                                    </td>



                                    <td class="text-end">

                                        <div class="action-buttons">

                                            @if (User.IsInRole("Admin") || User.IsInRole("Supervisor"))
                                            {
                                                <a asp-action="AttendanceSummary"
                                                   asp-route-workerId="@item.WorkerId"
                                                   class="btn-action btn-summary"
                                                   title="Attendance Summary">

                                                    <i class="bi bi-bar-chart-fill"></i>

                                                    <span>
                                                        Summary
                                                    </span>

                                                </a>


                                                <a asp-action="EditAttendance"
                                                   asp-route-id="@item.Id"
                                                   asp-route-workerId="@item.WorkerId"
                                                   class="btn-action btn-edit"
                                                   title="Edit Attendance">

                                                    <i class="bi bi-pencil-fill"></i>

                                                    <span>
                                                        Edit
                                                    </span>

                                                </a>
                                            }


                                        </div>

                                    </td>


                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {


                <div class="empty-attendance">

                    <div class="empty-icon">

                        <i class="bi bi-calendar-x"></i>

                    </div>


                    <h4>
                        No Attendance Records Found
                    </h4>


                    <p>

                        No worker attendance has been marked
                        for the selected date and camp.

                    </p>


                    @if (User.IsInRole("Admin") || User.IsInRole("Supervisor"))
                    {
                        <a asp-action="MarkAttendance"
                           class="btn btn-attendance-primary">

                            <i class="bi bi-person-check-fill me-2"></i>

                            Mark Attendance

                        </a>
                    }

                </div>

            }


        </div>

    </div>

</div>



