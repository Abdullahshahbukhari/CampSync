@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const campFilter =
                    document.getElementById(
                        "campFilter"
                    );

                const searchType =
                    document.getElementById(
                        "searchType"
                    );

                const campSearchBox =
                    document.getElementById(
                        "campSearchBox"
                    );

                const workerSearchBox =
                    document.getElementById(
                        "workerSearchBox"
                    );


                const selectedCampId =
                    '@selectedCampId';


                const currentSearchType =
                    '@(ViewBag.SearchType ?? "camp")';



                function updateSearchBox() {

                    if (
                        searchType.value === "worker"
                    ) {

                      
                        campSearchBox.style.display =
                            "none";

                        workerSearchBox.style.display =
                            "block";

                    }
                    else {

                    
                        campSearchBox.style.display =
                            "block";

                       
                        workerSearchBox.style.display =
                            "none";

                    }

                }


                searchType.addEventListener(
                    "change",
                    updateSearchBox
                );


        

                searchType.value =
                    currentSearchType;

                updateSearchBox();



                fetch('/Attendance/GetCamps')

                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "Unable to load camps"
                            );

                        }

                        return response.json();

                    })

                    .then(data => {

                        data.forEach(camp => {

                            const option =
                                document.createElement(
                                    "option"
                                );


                            option.value =
                                camp.id;


                            option.text =
                                `${camp.name ?? camp.campName} (ID: ${camp.id})`;


                            if (
                                selectedCampId !== "" &&
                                camp.id.toString() ===
                                selectedCampId
                            ) {

                                option.selected =
                                    true;

                            }


                            campFilter.appendChild(
                                option
                            );

                        });

                    })

                    .catch(error => {

                        console.error(
                            "Camp loading error:",
                            error
