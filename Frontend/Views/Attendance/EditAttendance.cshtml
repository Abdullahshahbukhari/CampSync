@model Frontend.DTOs.AttendanceUpdateModel

@{
    ViewData["Title"] = "Edit Attendance";

    var workerName =
        ViewBag.WorkerName as string;

    var attendanceDate =
        ViewBag.AttendanceDate as string;

    var attendanceId =
        ViewBag.AttendanceId;
}

<div class="container py-5">

    <div class="card border-0 shadow-sm"
         style="max-width:700px;margin:auto;border-radius:20px;">

        <div class="card-body p-5">

            <div class="mb-4">

                <span style="
                    color:#ff6b1a;
                    font-size:12px;
                    font-weight:700;
                    letter-spacing:1px;">

                    ATTENDANCE MANAGEMENT

                </span>

                <h2 class="fw-bold mt-2">

                    Edit Attendance

                </h2>

                <p class="text-muted">

                    Update the attendance status.

                </p>

            </div>


            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="text-muted">

                        Worker

                    </label>

                    <h5>

                        @workerName

                    </h5>

                </div>


                <div class="col-md-6">

                    <label class="text-muted">

                        Attendance Date

                    </label>

                    <h5>

                        @attendanceDate

                    </h5>

                </div>

            </div>


            <form asp-action="UpdateAttendance"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="id"
                       value="@attendanceId" />

                <input type="hidden"
                       name="atDate"
                       value="@attendanceDate" />


                <div class="mb-4">

                    <label asp-for="Status"
                           class="form-label fw-semibold">

                        Attendance Status

                    </label>

                    <select asp-for="Status"
                            class="form-select form-select-lg">

                        <option value="Present">
                            Present
                        </option>

                        <option value="Absent">
                            Absent
                        </option>

                        <option value="Leave">
                            Leave
                        </option>

                    </select>

                </div>


                <div class="d-flex gap-2">

                    <a asp-action="AttendanceList"
                       class="btn btn-light flex-fill">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn flex-fill"
                            style="
                        background:#ff6b1a;
                        color:white;">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        Update Attendance

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
   
    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

  
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

   
    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
      
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }
</style>

