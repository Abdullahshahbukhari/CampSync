        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
