@model Frontend.DTOs.LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - CampSync</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>


<body>

    <div class="login-page">

        <div class="container">

            <div class="row min-vh-100 align-items-center justify-content-center">

               
                <div class="col-lg-6 d-none d-lg-block">

                    <div class="brand-section">

                        <div class="brand-logo">

                            <i class="bi bi-house-heart-fill"></i>

                        </div>

                        <span class="brand-name">
                            CampSync
                        </span>

                        <h1>
                            Manage your workforce with confidence.
                        </h1>

                        <p>
                            A simple and powerful way to manage camps,
                            workers, rooms, attendance and transportation.
                        </p>


                        <div class="feature-list">

                            <div class="feature-item">

                                <div class="feature-icon">
                                    <i class="bi bi-buildings"></i>
                                </div>

                                <span>Manage Camps & Rooms</span>

                            </div>


                            <div class="feature-item">

                                <div class="feature-icon">
                                    <i class="bi bi-people-fill"></i>
                                </div>

                                <span>Manage Your Workforce</span>

                            </div>


                            <div class="feature-item">

                                <div class="feature-icon">
                                    <i class="bi bi-bar-chart-fill"></i>
                                </div>

                                <span>Track Everything Easily</span>

                            </div>

                        </div>

                    </div>

                </div>


             
                <div class="col-lg-5 col-md-8 col-sm-10">

                    <div class="login-card">

                        <div class="text-center mb-4">

                            <div class="mobile-logo d-lg-none">

                                <i class="bi bi-house-heart-fill"></i>

                            </div>

                            <span class="login-badge">
                                WELCOME BACK
                            </span>

                            <h2 class="mt-3">
                                Sign in to CampSync
                            </h2>

                            <p class="text-muted">
                                Enter your details to access your account.
                            </p>

                        </div>


                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger border-0">

                                <i class="bi bi-exclamation-circle-fill me-2"></i>

                                @ViewBag.Error

                            </div>
                        }


                        <form asp-action="Login"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


               

                            <div class="mb-4">

                                <label asp-for="Email"
                                       class="form-label custom-label">

                                    Email Address

                                </label>

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="bi bi-envelope-fill"></i>

                                    </span>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter your email" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="Password"
                                       class="form-label custom-label">

                                    Password

                                </label>

                                <div class="input-group custom-input">

                                    <span class="input-group-text">

                                        <i class="bi bi-lock-fill"></i>

                                    </span>

                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter your password" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <button type="submit"
                                    class="btn btn-login w-100">

                                Sign In

                                <i class="bi bi-arrow-right ms-2"></i>

                            </button>


                            <div class="text-center mt-4">

                                <span class="text-muted">

                                    Don't have an account?

                                </span>

                                <a asp-action="Register"
                                   class="register-link">

                                    Create Account

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>


<style>

    body {
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .login-page {
        min-height: 100vh;
        background: #fff7f1;
    }

    .brand-section {
        padding: 50px;
    }

    .brand-logo,
    .mobile-logo {
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, #ff6b1a, #ff9a5a);
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 12px 30px rgba(255, 107, 26, .25);
    }

    .brand-name {
        display: block;
        margin-top: 15px;
        font-size: 18px;
        font-weight: 700;
        color: #ff6b1a;
    }

    .brand-section h1 {
        font-size: 46px;
        font-weight: 700;
        margin-top: 25px;
        color: #222;
        line-height: 1.2;
    }

    .brand-section p {
        color: #6c757d;
        font-size: 17px;
        line-height: 1.7;
        max-width: 500px;
    }

    .feature-list {
        margin-top: 35px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .feature-icon {
        width: 45px;
        height: 45px;
        background: white;
        color: #ff6b1a;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 15px rgba(0,0,0,.05);
    }

    .login-card {
        background: white;
        padding: 45px;
        border-radius: 30px;
        box-shadow: 0 20px 60px rgba(0,0,0,.10);
    }

    .login-badge {
        color: #ff6b1a;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .login-card h2 {
        font-weight: 700;
        color: #222;
    }

    .custom-label {
        font-weight: 600;
        color: #333;
    }

    .custom-input .input-group-text {
        background: #fff4ed;
        border: 1px solid #eee;
        border-right: none;
        color: #ff6b1a;
        border-radius: 14px 0 0 14px;
    }

    .custom-input .form-control {
        min-height: 54px;
        border-left: none;
        border-radius: 0 14px 14px 0;
    }

        .custom-input .form-control:focus {
            box-shadow: none;
            border-color: #ff9a5a;
        }

    .btn-login {
        min-height: 54px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #ff6b1a, #ff974f);
        color: white;
        font-weight: 600;
        font-size: 16px;
        transition: .3s;
    }

        .btn-login:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255,107,26,.30);
        }

    .register-link {
        color: #ff6b1a;
        text-decoration: none;
        font-weight: 700;
        margin-left: 5px;
    }

    .mobile-logo {
        margin: auto auto 20px;
    }

    @@media (max-width: 768px) {

        .login-card {
            padding: 30px 25px;
            border-radius: 24px;
        }
    }


    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

  
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

   
    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

   @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
        
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}