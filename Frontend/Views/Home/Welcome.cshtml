@{
    ViewData["Title"] = "CampSync";
    var role = Context.Session.GetString("role") ?? "User";
}
<div class="camp-hero">
    <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
    <div class="hero-card">
        <div class="hero-mark"><i class="bi bi-buildings-fill"></i></div>
        <div class="hero-kicker">SMART WORKFORCE OPERATIONS</div>
        <h1>Camp<span>Sync</span></h1>
        <p>One connected workspace for camps, workers, buses, attendance and leave management.</p>
        <div class="hero-meta"><span><i class="bi bi-person-circle"></i> @User.Identity?.Name</span><span><i class="bi bi-shield-check"></i> @role</span></div>
        <a asp-controller="Profile" asp-action="MyProfile" class="hero-btn"><i class="bi bi-arrow-right-circle me-2"></i>Open My Profile</a>
        <div class="hero-features"><div><i class="bi bi-buildings"></i><span>Camps</span></div><div><i class="bi bi-bus-front"></i><span>Transport</span></div><div><i class="bi bi-calendar-check"></i><span>Attendance</span></div><div><i class="bi bi-people"></i><span>People</span></div></div>
    </div>
</div>
<style>
    body {
        background: #fff7f1
    }

    .camp-hero {
        min-height: 72vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        padding: 35px 15px
    }

    .hero-card {
        position: relative;
        z-index: 2;
        width: min(820px,100%);
        padding: 58px 45px;
        text-align: center;
        background: rgba(255,255,255,.92);
        border: 1px solid #f5e4da;
        border-radius: 34px;
        box-shadow: 0 25px 70px rgba(74,43,25,.10);
        backdrop-filter: blur(8px)
    }

    .hero-mark {
        width: 82px;
        height: 82px;
        margin: 0 auto 20px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
        color: #fff;
        background: linear-gradient(135deg,#ff6b1a,#ff9b5d);
        box-shadow: 0 15px 30px rgba(255,107,26,.25)
    }

    .hero-kicker {
        font-size: 11px;
        letter-spacing: 3px;
        font-weight: 800;
        color: #ff6b1a
    }

    .hero-card h1 {
        font-size: 64px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -2px;
        margin: 14px 0
    }

        .hero-card h1 span {
            color: #ff6b1a
        }

    .hero-card p {
        max-width: 590px;
        margin: 0 auto;
        color: #6d625b;
        font-size: 17px;
        line-height: 1.7
    }

    .hero-meta {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin: 25px 0
    }

        .hero-meta span {
            background: #fff0e7;
            color: #ff6b1a;
            border-radius: 12px;
            padding: 9px 14px;
            font-weight: 700;
            font-size: 13px
        }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg,#ff6b1a,#ff944d);
        padding: 12px 21px;
        border-radius: 13px;
        font-weight: 700;
        box-shadow: 0 10px 22px rgba(255,107,26,.22)
    }

    .hero-features {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 30px
    }

        .hero-features div {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 10px 13px;
            border: 1px solid #f1e3da;
            border-radius: 12px;
            color: #5f554f;
            font-size: 13px;
            font-weight: 700
        }

        .hero-features i {
            color: #ff6b1a
        }

    .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        opacity: .6
    }

    .glow-one {
        width: 320px;
        height: 320px;
        background: #ffe0cb;
        top: -110px;
        left: -90px
    }

    .glow-two {
        width: 360px;
        height: 360px;
        background: #ffe9d9;
        right: -120px;
        bottom: -130px
    }

    @@media (max-width:600px) {
        .hero-card {
            padding: 42px 22px
        }

            .hero-card h1 {
                font-size: 48px
            }

            .hero-card p {
                font-size: 15px
            }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

  
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>
