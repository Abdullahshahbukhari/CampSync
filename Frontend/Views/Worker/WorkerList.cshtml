@model List<Frontend.DTOs.WorkerResponseModel>

@{
    ViewData["Title"] = "Worker Management";
    var role = Context.Session.GetString("role");
}

<div class="container-fluid py-4">

    <div class="worker-header mb-4">

        <div>

            <span class="section-badge">
                WORKER MANAGEMENT
            </span>

            <h1 class="mt-2 mb-1">
                Manage Your Workers
            </h1>

            <p class="text-muted mb-0">
                Search and manage workers from one place.
            </p>

        </div>

        @if (role == "Admin")
        {
            <a asp-action="CreateWorker"
               class="btn btn-worker-primary mt-3 mt-md-0">

                <i class="bi bi-plus-lg"></i>
                Create Worker

            </a>
        }

    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @ViewBag.Error

        </div>
    }

    <div class="row g-4 mb-4">


        <div class="col-md-6 col-xl-4">

            <div class="stat-card">

                <div class="stat-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

                <div>

                    <span class="stat-label">
                        Workers Found
                    </span>

                    <h2>
                        @(Model?.Count ?? 0)
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-4">

            <div class="stat-card">

                <div class="stat-icon">

                    <i class="bi bi-building"></i>

                </div>

                <div>

                    <span class="stat-label">
                        Camps Found
                    </span>

                    <h2>
                        @(Model?.Select(x => x.CampName).Distinct().Count() ?? 0)
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-4">

            <div class="stat-card">

                <div class="stat-icon">

                    <i class="bi bi-activity"></i>

                </div>

                <div>

                    <span class="stat-label">
                        System Status
                    </span>

                    <h5 class="mb-0 text-success fw-bold">
                        Active
                    </h5>

                </div>

            </div>

        </div>

    </div>
    @if (role == "Supervisor")
    {
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <i class="bi bi-shield-check me-2"></i>
            Supervisor view is limited to your assigned camp. The backend also enforces this restriction.
        </div>
    }

    <div class="card worker-main-card border-0">

        <div class="card-body p-0">
            <div class="worker-list-top p-4">

                <div>

                    <h4 class="mb-1 fw-bold">
                        Worker Directory
                    </h4>

                    <p class="text-muted mb-0">
                        Search workers by Worker ID or Camp ID.
                    </p>

                </div>
                <form asp-action="WorkerList"
                      method="get"
                      class="worker-search-form">

                    <select id="searchType"
                            name="searchType"
                            class="form-select search-select">

                        <option value="">
                            Search By
                        </option>

                        <option value="worker"
                                selected="@(ViewBag.SearchType == "worker")">

                            Worker ID

                        </option>

                        <option value="camp"
                                selected="@(ViewBag.SearchType == "camp")">

                            Camp

                        </option>

                    </select>

                    <div id="workerSearchBox"
                         class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="number"
                               id="workerSearchId"
                               name="searchId"
                               class="form-control"
                               value="@(ViewBag.SearchType == "worker" ? ViewBag.SearchId : "")"
                               placeholder="Enter Worker ID..." />

                    </div>

                    <div id="campSearchBox"
                         class="search-box"
                         style="display:none;">

                        <i class="bi bi-building"></i>

                        <select id="campSearchId"
                                name="searchId"
                                class="form-select">

                            <option value="">
                                Select Camp
                            </option>

                        </select>

                    </div>
                    <button type="submit"
                            class="btn btn-worker-primary">

                        <i class="bi bi-search"></i>

                        Search

                    </button>

                </form>

            </div>

            <div class="table-responsive">

                <table class="table align-middle mb-0 worker-table">

                    <thead>

                        <tr>

                            <th>
                                Worker
                            </th>

                            <th>
                                Iqama No
                            </th>

                            <th>
                                Nationality
                            </th>

                            <th>
                                Bus
                            </th>

                            <th>
                                Camp
                            </th>

                            <th>
                                Bed
                            </th>

                            <th class="text-center">
                                Worker ID
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var worker in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="worker-avatar">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-1 fw-bold">

                                                    @worker.Name

                                                </h6>

                                                <small class="text-muted">

                                                    Registered Worker

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="worker-badge">

                                            <i class="bi bi-card-text"></i>

                                            @worker.IqamaNo

                                        </span>

                                    </td>

                                    <td>

                                        <span class="nationality-text">

                                            <i class="bi bi-globe"></i>

                                            @worker.Nationality

                                        </span>

                                    </td>

                                    <td>

                                        <span class="worker-badge">

                                            <i class="bi bi-bus-front-fill"></i>

                                            Bus @worker.BusNo

                                        </span>

                                    </td>

                                    <td>

                                        <span class="camp-text">

                                            <i class="bi bi-building"></i>

                                            @worker.CampName

                                        </span>

                                    </td>

                                    <td>

                                        <span class="worker-badge">

                                            <i class="bi bi-door-closed-fill"></i>

                                            Bed @worker.BedNo

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <span class="id-badge">

                                            #@worker.Id

                                        </span>

                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end align-items-center gap-2 action-buttons">

                                            @if (role == "Admin" || role == "Supervisor")
                                            {
                                                <a asp-action="WorkerById"
                                                   asp-route-id="@worker.Id"
                                                   class="action-btn details-btn">

                                                    <i class="bi bi-eye-fill"></i>

                                                    <span>
                                                        Details
                                                    </span>

                                                </a>
                                            }

                                         
                                            @if (role == "Admin")
                                            {
                                                <a asp-action="EditWorker"
                                                   asp-route-id="@worker.Id"
                                                   class="action-btn edit-btn">

                                                    <i class="bi bi-pencil-square"></i>

                                                    <span>
                                                        Edit
                                                    </span>

                                                </a>
                                                <a asp-action="DeleteWorker"
                                                   asp-route-id="@worker.Id"
                                                   class="action-btn delete-btn">

                                                    <i class="bi bi-trash-fill"></i>

                                                    <span>
                                                        Delete
                                                    </span>

                                                </a>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5 text-muted">

                                    <div class="empty-state">

                                        <div class="empty-icon">

                                            <i class="bi bi-people-fill"></i>

                                        </div>

                                        <h5 class="fw-bold">
                                            No Workers Available
                                        </h5>

                                        <p class="mb-0">
                                            Search by Worker ID or Camp ID.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    <script >

        document.addEventListener("DOMContentLoaded", function () {

                                const searchType =
                                    document.getElementById("searchType");

                                const workerSearchBox =
                                    document.getElementById("workerSearchBox");

                                const campSearchBox =
                                    document.getElementById("campSearchBox");

                                const workerInput =
                                    document.getElementById("workerIdInput");

                                const campSelect =
                                    document.getElementById("campSelect");


                                // =====================================
                                // LOAD CAMPS
                                // =====================================

                                async function loadCamps() {

                                    try {

                                        const response =
                                            await fetch(
                                                '@Url.Action("GetCamps", "Worker")'
                                            );

                                        if (!response.ok) {
                                            return;
                                        }

                                        const camps =
                                            await response.json();


                                        campSelect.innerHTML =
                                            '<option value="">Select Camp</option>';


                                        camps.forEach(function (camp) {

                                            const option =
                                                document.createElement("option");

                                            option.value =
                                                camp.id;

                                            option.text =
                                                camp.name +
                                                " (ID: " +
                                                camp.id +
                                                ")";


                                            if (
                                                '@ViewBag.SearchType' === "camp" &&
                                                '@ViewBag.SearchId' == camp.id
                                            ) {
                                                option.selected = true;
                                            }


                                            campSelect.appendChild(option);

                                        });

                                    }
                                    catch (error) {

                                        console.error(
                                            "Error loading camps:",
                                            error
                                        );

                                    }

                                }


                                // =====================================
                                // CHANGE SEARCH TYPE
                                // =====================================

                                function updateSearchField() {

                                    const type =
                                        searchType.value;


                                    // WORKER ID

                                    if (type === "worker") {

                                        workerSearchBox.style.display =
                                            "block";

                                        campSearchBox.style.display =
                                            "none";


                                        workerInput.disabled =
                                            false;

                                        campSelect.disabled =
                                            true;

                                        return;
                                    }


                                    // CAMP

                                    if (type === "camp") {

                                        workerSearchBox.style.display =
                                            "none";

                                        campSearchBox.style.display =
                                            "block";


                                        workerInput.disabled =
                                            true;

                                        campSelect.disabled =
                                            false;


                                        loadCamps();

                                        return;
                                    }


                                    // DEFAULT

                                    workerSearchBox.style.display =
                                        "none";

                                    campSearchBox.style.display =
                                        "none";


                                    workerInput.disabled =
                                        true;

                                    campSelect.disabled =
                                        true;

                                }


                                // CHANGE EVENT

                                searchType.addEventListener(
                                    "change",
                                    updateSearchField
                                );


                                // PAGE LOAD

                                updateSearchField();

                            });

    </script >

