<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchType =
            document.getElementById("searchType");

        const workerSearchBox =
            document.getElementById("workerSearchBox");

        const campSearchBox =
            document.getElementById("campSearchBox");

        const workerSearchId =
            document.getElementById("workerSearchId");

        const campSearchId =
            document.getElementById("campSearchId");


        searchType.addEventListener("change", function() {

            const selectedType = this.value;


            if (selectedType === "worker") {

                workerSearchBox.style.display =
                    "block";

                campSearchBox.style.display =
                    "none";

                workerSearchId.disabled =
                    false;

                campSearchId.disabled =
                    true;

                workerSearchId.value = "";

                campSearchId.value = "";

            }

            else if (selectedType === "camp") {

                workerSearchBox.style.display =
                    "none";

                campSearchBox.style.display =
                    "block";

                workerSearchId.disabled =
                    true;

                campSearchId.disabled =
                    false;

                loadCamps();

            }

            else {

                workerSearchBox.style.display =
                    "block";

                campSearchBox.style.display =
                    "none";

                workerSearchId.disabled =
                    false;

                campSearchId.disabled =
                    true;

            }

        });

        function loadCamps() {

            if (campSearchId.options.length > 1) {
                return;
            }


            fetch('/Worker/GetCamps')

                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "Failed to load camps"
                        );

                    }

                    return response.json();

                })

                .then(camps => {

                    campSearchId.innerHTML =
                        '<option value="">Select Camp</option>';


                    camps.forEach(camp => {

                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            camp.id;

                        option.text =
                            camp.name +
                            " (ID: " +
                            camp.id +
                            ")";
                        if (
                            '@ViewBag.SearchType' === "camp"
                            &&
                            '@ViewBag.SearchId' == camp.id
                        ) {

                            option.selected =
                                true;

                        }


                        campSearchId.appendChild(
                            option
                        );

                    });

                })

                .catch(error => {

                    console.error(
                        error
                    );

                });

        }

        const currentSearchType =
            searchType.value;


        if (currentSearchType === "camp") {

            workerSearchBox.style.display =
                "none";

            campSearchBox.style.display =
                "block";

            workerSearchId.disabled =
                true;

            campSearchId.disabled =
                false;

            loadCamps();

        }

        else if (
            currentSearchType === "worker"
        ) {

            workerSearchBox.style.display =
                "block";

            campSearchBox.style.display =
                "none";

            workerSearchId.disabled =
