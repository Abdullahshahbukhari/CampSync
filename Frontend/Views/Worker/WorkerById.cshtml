@model Frontend.DTOs.WorkerResponseModel

@{
    ViewData["Title"] = "Worker Details";
    var role = Context.Session.GetString("role");
}

<div class="container py-4">

    <div class="details-header mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="worker-avatar-large">

                <i class="bi bi-person-fill"></i>

            </div>

            <div>

                <span class="section-badge">
                    WORKER DETAILS
                </span>

                <h1 class="mt-2 mb-1">
                    @Model.Name
                </h1>

                <p class="text-muted mb-0">
                    Complete worker information.
                </p>

            </div>

        </div>


        <a asp-action="WorkerList"
           class="btn btn-back">

            <i class="bi bi-arrow-left"></i>

            Back

        </a>

    </div>

    <div class="details-card">

        <div class="details-card-header">

            <div>

                <h4 class="mb-1">
                    Worker Information
                </h4>

                <p class="text-muted mb-0">
                    Details and assignments of this worker.
                </p>

            </div>


            <span class="id-badge-large">

                #@Model.Id

            </span>

        </div>


        <hr />


        <div class="row g-4">

            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-person-fill"></i>

                    </div>

                    <div>

                        <small>
                            Worker Name
                        </small>

                        <h5>
                            @Model.Name
                        </h5>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-card-text"></i>

                    </div>

                    <div>

                        <small>
                            Iqama Number
                        </small>

                        <h5>
                            @Model.IqamaNo
                        </h5>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-globe"></i>

                    </div>

                    <div>

                        <small>
                            Nationality
                        </small>

                        <h5>
                            @Model.Nationality
                        </h5>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-bus-front-fill"></i>

                    </div>

                    <div>

                        <small>
                            Bus Number
                        </small>

                        <h5>
                            Bus @Model.BusNo
                        </h5>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-building"></i>

                    </div>

                    <div>

                        <small>
                            Camp
                        </small>

                        <h5>
                            @Model.CampName
                        </h5>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="detail-item">

                    <div class="detail-icon">

                        <i class="bi bi-door-closed-fill"></i>

                    </div>

                    <div>

                        <small>
                            Bed Number
                        </small>

                        <h5>
                            Bed @Model.BedNo
                        </h5>

                    </div>

                </div>

            </div>

        </div>

        <div class="details-actions mt-5">

            @if (role == "Admin")
            {
                <a asp-action="EditWorker"
                   asp-route-id="@Model.Id"
                   class="btn btn-worker-primary">

                    <i class="bi bi-pencil-square"></i>

                    Edit Worker

                </a>

                <a asp-action="DeleteWorker"
                   asp-route-id="@Model.Id"
                   class="btn btn-delete">

                    <i class="bi bi-trash-fill"></i>

                    Delete Worker

                </a>
            }

        </div>
    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #ffffff, #fff4ec);
        padding: 32px;
        border-radius: 24px;
        box-shadow: 0 12px 40px rgba(0,0,0,.05);
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ff6b1a;
    }

    .worker-avatar-large {
        width: 75px;
        height: 75px;
        border-radius: 23px;
        background: linear-gradient(135deg, #ff6b1a, #ff9a5a);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 32px;
        box-shadow: 0 10px 25px rgba(255,107,26,.25);
    }

    .details-card {
        background: white;
        padding: 35px;
        border-radius: 24px;
        box-shadow: 0 15px 40px rgba(0,0,0,.06);
    }

    .details-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-radius: 18px;
        background: #fffaf7;
        border: 1px solid #fff0e7;
    }

    .detail-icon {
        width: 48px;
        height: 48px;
        border-radius: 15px;
        background: #fff0e7;
        color: #ff6b1a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .detail-item small {
        color: #888;
    }

    .detail-item h5 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .id-badge-large {
        background: #fff0e7;
        color: #ff6b1a;
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-worker-primary {
        background: linear-gradient(135deg, #ff6b1a, #ff944d);
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
    }

        .btn-worker-primary:hover {
            color: white;
        }

    .btn-back {
        background: white;
        border: 1px solid #eee;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
    }

    .btn-delete {
        background: #ffebeb;
        color: #dc3545;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        margin-left: 10px;
    }

    .details-actions {
        display: flex;
        gap: 10px;
    }

    @@media (max-width: 768px) {

        .details-header,
        .details-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .details-card {
            padding: 25px;
        }
    }
    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }
    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>