@model Frontend.DTOs.CampResponseModel

@{
    ViewData["Title"] = "Camp Details";
}

<div class="container py-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <a asp-action="CampList"
       class="back-link">

        <i class="bi bi-arrow-left"></i>
        Back to Camps

    </a>


    <div class="card details-card border-0 mt-4">

       
        <div class="camp-details-header">

            <div class="d-flex align-items-center gap-3">

                <div class="details-icon">

                    <i class="bi bi-buildings-fill"></i>

                </div>

                <div>

                    <span class="small text-uppercase opacity-75">
                        Camp Details
                    </span>

                    <h2 class="mb-0">
                        @Model.Name
                    </h2>

                </div>

            </div>


            <span class="camp-id">
                #@Model.Id
            </span>

        </div>


        <div class="card-body p-4 p-md-5">

            <div class="location-card mb-5">

                <div class="location-icon">

                    <i class="bi bi-geo-alt-fill"></i>

                </div>

                <div>

                    <span class="text-muted">
                        Camp Location
                    </span>

                    <h5 class="mb-0">
                        @Model.Location
                    </h5>

                </div>

            </div>


            <div class="row g-4">

                <div class="col-md-6">

                    <div class="detail-stat-card">

                        <div class="detail-stat-icon">

                            <i class="bi bi-door-open"></i>

                        </div>

                        <div>

                            <span>Total Rooms</span>

                            <h2>
                                @Model.TotalRooms
                            </h2>

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="detail-stat-card">

                        <div class="detail-stat-icon">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <div>

                            <span>Total Workers</span>

                            <h2>
                                @Model.TotalWorkers
                            </h2>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-5" />


           
            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex gap-3 flex-column flex-sm-row">

                    <a asp-action="EditCamp"
                       asp-route-id="@Model.Id"
                       class="btn btn-edit-camp flex-fill">

                        <i class="bi bi-pencil-square me-2"></i>

                        Edit Camp

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-delete-camp flex-fill">

                        <i class="bi bi-trash me-2"></i>

                        Delete Camp

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .back-link {
        text-decoration: none;
        color: #6c757d;
        font-weight: 600;
    }

        .back-link:hover {
            color: #ff6b1a;
        }

    .details-card {
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
    }

    .camp-details-header {
        background: linear-gradient(135deg, #ff6b1a, #ff9b57);
        color: white;
        padding: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .details-icon {
        width: 65px;
        height: 65px;
        background: rgba(255,255,255,.18);
        border-radius: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
    }

    .camp-id {
        background: rgba(255,255,255,.2);
        padding: 8px 15px;
        border-radius: 12px;
    }

    .location-card {
        background: #fff7f2;
        padding: 22px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .location-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: white;
        color: #ff6b1a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .detail-stat-card {
        background: white;
        border: 1px solid #f1f1f1;
        border-radius: 22px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .detail-stat-icon {
        width: 60px;
        height: 60px;
        background: #fff0e7;
        color: #ff6b1a;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .detail-stat-card span {
        color: #777;
    }

    .detail-stat-card h2 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .btn-edit-camp {
        background: #fff1df;
        color: #e98a00;
        border-radius: 14px;
        padding: 14px;
        font-weight: 600;
    }

    .btn-delete-camp {
        background: #ffe9e9;
        color: #dc3545;
        border-radius: 14px;
        padding: 14px;
        font-weight: 600;
    }

    @@media(max-width: 576px) {

        .camp-details-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>