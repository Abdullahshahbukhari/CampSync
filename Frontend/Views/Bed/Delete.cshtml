@model Frontend.DTOs.BedResponseModel

@{
    ViewData["Title"] = "Delete Bed";

    int roomId = ViewBag.RoomId;
    int? campId = ViewBag.CampId;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow rounded-5 overflow-hidden">

                <div class="card-header bg-danger text-white p-4">

                    <h3 class="mb-0 fw-bold">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        Delete Bed

                    </h3>

                </div>


                <div class="card-body p-5 text-center">

                    <div class="display-3 text-danger mb-3">

                        <i class="bi bi-trash3"></i>

                    </div>


                    <h4>
                        Are you sure?
                    </h4>


                    <p class="text-muted">

                        You are about to delete:

                    </p>


                    <div class="bg-light rounded-4 p-4 mb-4">

                        <h5 class="mb-2">
                            Bed @Model.BedNo
                        </h5>

                        <span class="text-muted">
                            Room @Model.RoomNo
                        </span>

                    </div>


                    <form asp-action="DeleteConfirmed"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <input type="hidden"
                               name="roomId"
                               value="@roomId" />

                        <input type="hidden"
                               name="campId"
                               value="@campId" />


                        <a asp-action="BedList"
                           asp-route-campId="@campId"
                           asp-route-roomId="@roomId"
                           class="btn btn-light px-4">

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-danger px-4 ms-2">

                            <i class="bi bi-trash me-1"></i>

                            Yes, Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<style>
 
    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }
</style>

