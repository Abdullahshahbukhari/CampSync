@model Frontend.DTOs.BusResponseModel

@{
    ViewData["Title"] = "Bus Details";
}

<div class="container-fluid py-4">

    <div class="page-header mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="header-icon">

                <i class="bi bi-bus-front-fill"></i>

            </div>


            <div>

                <span class="section-badge">
                    BUS MANAGEMENT
                </span>

                <h1 class="mt-1 mb-1">

                    Bus Details

                </h1>

                <p class="text-muted mb-0">

                    Complete information about this bus.

                </p>

            </div>

        </div>


        <a asp-action="BusList"
           class="btn btn-back">

            <i class="bi bi-arrow-left"></i>

            Back to Buses

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-9">


            <div class="details-card">


                <div class="bus-profile text-center">


                    <div class="bus-main-icon">

                        <i class="bi bi-bus-front-fill"></i>

                    </div>


                    <h2 class="fw-bold mt-3">

                        Bus @Model.BusNo

                    </h2>


                    <span class="status-badge">

                        <i class="bi bi-check-circle-fill"></i>

                        Registered Bus

                    </span>


                </div>


                <hr class="my-4" />


                <div class="row g-4">


                    <div class="col-md-6">

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="bi bi-bus-front-fill"></i>

                            </div>

                            <div>

                                <span>
                                    Bus Number
                                </span>

                                <h5>
                                    @Model.BusNo
                                </h5>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="bi bi-person-badge-fill"></i>

                            </div>

                            <div>

                                <span>
                                    Assigned Driver
                                </span>

                                <h5>
                                    @Model.DriverName
                                </h5>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="bi bi-people-fill"></i>

                            </div>

                            <div>

                                <span>
                                    Assigned Workers
                                </span>

                                <h5>
                                    @Model.TotalWorkersAssigned
                                </h5>

                            </div>

                        </div>

                    </div>


                    <!-- ID -->

                    <div class="col-md-6">

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="bi bi-hash"></i>

                            </div>

                            <div>

                                <span>
                                    Bus ID
                                </span>

                                <h5>
                                    #@Model.Id
                                </h5>

                            </div>

                        </div>

                    </div>


                </div>

                <div class="details-actions mt-5">


                    <a asp-action="EditBus"
                       asp-route-id="@Model.Id"
                       class="btn btn-edit-custom">

                        <i class="bi bi-pencil-square"></i>

                        Edit Bus

                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-delete-custom">

                        <i class="bi bi-trash-fill"></i>

                        Delete Bus

                    </a>


                </div>


            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .page-header {
        background: linear-gradient(135deg,#ffffff,#fff4ec);
        padding: 30px;
        border-radius: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 12px 40px rgba(0,0,0,.05);
    }

    .header-icon {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        color: white;
        font-size: 28px;
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        color: #ff6b1a;
        letter-spacing: 1px;
    }

    .btn-back {
        background: white;
        border: 1px solid #f0d8c9;
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 600;
    }

    .details-card {
        background: white;
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0 15px 45px rgba(0,0,0,.06);
    }

    .bus-profile {
        padding: 10px;
    }

    .bus-main-icon {
        width: 100px;
        height: 100px;
        margin: auto;
        border-radius: 28px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 45px;
        color: white;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        box-shadow: 0 15px 30px rgba(255,107,26,.25);
    }

    .status-badge {
        display: inline-flex;
        gap: 7px;
        align-items: center;
        padding: 8px 15px;
        background: #e8f8ee;
        color: #198754;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .detail-item {
        border: 1px solid #f0f0f0;
        border-radius: 18px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        transition: .3s;
    }

        .detail-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,.05);
        }

    .detail-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff0e7;
        color: #ff6b1a;
        font-size: 22px;
    }

    .detail-item span {
        font-size: 13px;
        color: #888;
    }

    .detail-item h5 {
        margin: 3px 0 0;
        font-weight: 700;
    }

    .details-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-edit-custom,
    .btn-delete-custom {
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
    }

    .btn-edit-custom {
        background: #fff0e7;
        color: #ff6b1a;
    }

        .btn-edit-custom:hover {
            background: #ff6b1a;
            color: white;
        }

    .btn-delete-custom {
        background: #ffebeb;
        color: #dc3545;
    }

        .btn-delete-custom:hover {
            background: #dc3545;
            color: white;
        }

    @@media(max-width:768px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .details-card {
            padding: 22px;
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
      
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>