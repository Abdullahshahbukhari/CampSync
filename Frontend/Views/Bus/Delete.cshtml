@model Frontend.DTOs.BusResponseModel

@{
    ViewData["Title"] = "Delete Bus";
}

<div class="container-fluid py-4">


    <div class="page-header mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="header-icon delete-header-icon">

                <i class="bi bi-trash-fill"></i>

            </div>


            <div>

                <span class="section-badge delete-badge">

                    DELETE BUS

                </span>

                <h1 class="mt-1 mb-1">

                    Delete Bus

                </h1>

                <p class="text-muted mb-0">

                    Review the bus information before permanently deleting it.

                </p>

            </div>

        </div>


        <a asp-action="Busbyid"
           asp-route-id="@Model.Id"
           class="btn btn-back">

            <i class="bi bi-arrow-left"></i>

            Back to Details

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">


            <div class="delete-card">


                <div class="text-center mb-4">

                    <div class="warning-icon">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                    </div>


                    <h3 class="fw-bold mt-3">

                        Are you sure?

                    </h3>


                    <p class="text-muted">

                        You are about to permanently delete this bus.

                    </p>

                </div>


                <div class="delete-bus-info">


                    <div class="delete-bus-icon">

                        <i class="bi bi-bus-front-fill"></i>

                    </div>


                    <div class="flex-grow-1">


                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                            <div>

                                <span class="small text-muted">

                                    BUS

                                </span>

                                <h4 class="mb-0 fw-bold">

                                    Bus @Model.BusNo

                                </h4>

                            </div>


                            <span class="bus-id">

                                ID #@Model.Id

                            </span>

                        </div>


                    </div>

                </div>


                <!-- DETAILS -->

                <div class="delete-details mt-4">


                    <div class="delete-detail-item">

                        <i class="bi bi-person-badge-fill"></i>

                        <div>

                            <small>

                                Assigned Driver

                            </small>

                            <strong>

                                @Model.DriverName

                            </strong>

                        </div>

                    </div>


                    <div class="delete-detail-item">

                        <i class="bi bi-people-fill"></i>

                        <div>

                            <small>

                                Assigned Workers

                            </small>

                            <strong>

                                @Model.TotalWorkersAssigned

                            </strong>

                        </div>

                    </div>


                </div>


                <div class="danger-warning mt-4">

                    <i class="bi bi-exclamation-octagon-fill"></i>

                    <div>

                        <strong>

                            Important Warning

                        </strong>

                        <p class="mb-0">

                            If this bus has workers assigned to it, the backend will not allow it to be deleted until those workers are reassigned.

                        </p>

                    </div>

                </div>


                <form asp-action="DeleteConfirmed"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="mt-5">

                    @Html.AntiForgeryToken()


                    <div class="d-flex justify-content-center gap-3 flex-wrap">


                        <a asp-action="Busbyid"
                           asp-route-id="@Model.Id"
                           class="btn btn-cancel">

                            <i class="bi bi-x-circle"></i>

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-danger-custom">

                            <i class="bi bi-trash-fill"></i>

                            Yes, Delete Bus

                        </button>


                    </div>

                </form>


            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .page-header {
        background: linear-gradient(135deg,#ffffff,#fff4ec);
        padding: 30px;
        border-radius: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 12px 40px rgba(0,0,0,.05);
    }

    .header-icon {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        color: white;
        font-size: 28px;
    }

    .delete-header-icon {
        background: linear-gradient(135deg,#dc3545,#f05a68);
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ff6b1a;
    }

    .delete-badge {
        color: #dc3545;
    }

    .btn-back {
        background: white;
        border: 1px solid #f0d8c9;
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 600;
        color: #555;
    }

    .delete-card {
        background: white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 15px 45px rgba(0,0,0,.06);
    }

    .warning-icon {
        width: 90px;
        height: 90px;
        margin: auto;
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffebeb;
        color: #dc3545;
        font-size: 40px;
    }

    .delete-bus-info {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;
        background: #fff8f4;
        border-radius: 20px;
    }

    .delete-bus-icon {
        width: 60px;
        height: 60px;
        min-width: 60px;
        border-radius: 18px;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 26px;
    }

    .bus-id {
        background: white;
        border: 1px solid #f0e0d6;
        padding: 7px 13px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .delete-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .delete-detail-item {
        display: flex;
        gap: 14px;
        align-items: center;
        padding: 18px;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
    }

        .delete-detail-item > i {
            color: #ff6b1a;
            font-size: 22px;
        }

        .delete-detail-item small,
        .delete-detail-item strong {
            display: block;
        }

        .delete-detail-item small {
            color: #888;
        }

    .danger-warning {
        background: #fff0f1;
        border-left: 4px solid #dc3545;
        padding: 18px;
        border-radius: 14px;
        display: flex;
        gap: 14px;
    }

        .danger-warning > i {
            color: #dc3545;
            font-size: 21px;
        }

        .danger-warning p {
            color: #777;
            font-size: 14px;
            margin-top: 4px;
        }

    .btn-cancel {
        background: #f5f5f5;
        color: #666;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg,#dc3545,#ee5665);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(220,53,69,.20);
    }

        .btn-danger-custom:hover {
            color: white;
            transform: translateY(-2px);
        }

    @@media(max-width:768px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .delete-card {
            padding: 22px;
        }

        .delete-details {
            grid-template-columns: 1fr;
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>