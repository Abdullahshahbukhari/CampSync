@model Frontend.DTOs.RoomResponseModel

@{
    var userRole = Context.Session.GetString("role");
    var isAdmin = userRole == "Admin";
    ViewData["Title"] = "Room Details";
}

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="details-header mb-4">

        <div>

            <span class="section-badge">
                ROOM DETAILS
            </span>

            <h1 class="mt-2 mb-1">
                Room @Model.RoomNo
            </h1>

            <p class="text-muted mb-0">
                View complete room information.
            </p>

        </div>

        <a asp-action="RoomList"
           asp-route-campId="@Model.CampId"
           class="btn btn-back">

            <i class="bi bi-arrow-left me-2"></i>

            Back to Rooms

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="details-card">

                <div class="details-top">

                    <div class="details-icon">

                        <i class="bi bi-door-open-fill"></i>

                    </div>

                    <div>

                        <span class="text-muted">
                            ROOM NUMBER
                        </span>

                        <h2 class="fw-bold mb-0">
                            @Model.RoomNo
                        </h2>

                    </div>

                </div>


                <hr />


                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="info-icon">

                                <i class="bi bi-hash"></i>

                            </div>

                            <div>

                                <small>
                                    Room ID
                                </small>

                                <h5>
                                    #@Model.Id
                                </h5>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-box">

                            <div class="info-icon">

                                <i class="bi bi-buildings-fill"></i>

                            </div>

                            <div>

                                <small>
                                    Camp ID
                                </small>

                                <h5>
                                    #@Model.CampId
                                </h5>

                            </div>

                        </div>

                    </div>

                </div>


                @if (isAdmin)
                {
                    <div class="details-actions mt-5">

                        <a asp-action="EditRoom"
                           asp-route-id="@Model.Id"
                           class="btn action-edit">

                            <i class="bi bi-pencil-square me-2"></i>
                            Edit Room

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn action-delete">

                            <i class="bi bi-trash-fill me-2"></i>
                            Delete Room

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ff6b1a;
    }

    .details-header h1 {
        font-weight: 700;
    }

    .details-card {
        background: white;
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0 15px 45px rgba(0,0,0,.07);
    }

    .details-top {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .details-icon {
        width: 75px;
        height: 75px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        color: white;
        font-size: 30px;
    }

    .info-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #fff9f5;
        border-radius: 17px;
    }

    .info-icon {
        width: 45px;
        height: 45px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 14px;
        background: #fff0e7;
        color: #ff6b1a;
        font-size: 20px;
    }

    .info-box small {
        color: #777;
    }

    .info-box h5 {
        margin: 4px 0 0;
        font-weight: 700;
    }

    .details-actions {
        display: flex;
        gap: 15px;
    }

    .action-edit {
        flex: 1;
        background: #fff2df;
        color: #e98a00;
        padding: 13px;
        border-radius: 13px;
        font-weight: 600;
    }

    .action-delete {
        flex: 1;
        background: #ffebeb;
        color: #dc3545;
        padding: 13px;
        border-radius: 13px;
        font-weight: 600;
    }

    .btn-back {
        border: 1px solid #ddd;
        background: white;
        border-radius: 13px;
        padding: 12px 20px;
    }

    @@media(max-width: 576px) {

        .details-header {
            flex-direction: column;
            align-items: stretch;
            gap: 20px;
        }

        .details-card {
            padding: 25px;
        }

        .details-actions {
            flex-direction: column;
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
    
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>