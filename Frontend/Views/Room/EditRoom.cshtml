@using Frontend.DTOs
@model RoomUpdateModel

@{
    ViewData["Title"] = "Edit Room";

    var camps = ViewBag.Camps as List<CampResponseModel>
                ?? new List<CampResponseModel>();

    var roomId = ViewBag.RoomId;
}

<div class="container py-4">

    <div class="form-page-header mb-4">

        <div>

            <span class="section-badge">
                ROOM MANAGEMENT
            </span>

            <h1 class="mt-2 mb-1">
                Edit Room
            </h1>

            <p class="text-muted mb-0">
                Update the room information.
            </p>

        </div>

        <a asp-action="Roombyid"
           asp-route-id="@roomId"
           class="btn btn-back">

            <i class="bi bi-arrow-left me-2"></i>

            Back to Details

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card form-card border-0">

                <div class="card-body p-4 p-md-5">

                    <div class="form-icon">

                        <i class="bi bi-pencil-square"></i>

                    </div>


                    <h3 class="fw-bold mt-3">
                        Update Room
                    </h3>

                    <p class="text-muted mb-4">
                        Modify the required fields and save changes.
                    </p>


                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">

                            <i class="bi bi-exclamation-triangle-fill me-2"></i>

                            @ViewBag.Error

                        </div>
                    }


                    <form asp-action="EditRoom"
                          asp-route-id="@roomId"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-4">

                            <label asp-for="CampId"
                                   class="form-label">

                                Select Camp

                            </label>

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="bi bi-buildings-fill"></i>

                                </span>

                                <select asp-for="CampId"
                                        class="form-select">

                                    @foreach (var camp in camps)
                                    {
                                        <option value="@camp.Id">

                                            @camp.Name

                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="CampId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="RoomNo"
                                   class="form-label">

                                Room Number

                            </label>

                            <div class="input-group custom-input">

                                <span class="input-group-text">

                                    <i class="bi bi-door-open-fill"></i>

                                </span>

                                <input asp-for="RoomNo"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="RoomNo"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="d-flex gap-3">

                            <a asp-action="Roombyid"
                               asp-route-id="@roomId"
                               class="btn btn-cancel flex-fill">

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-room-primary flex-fill">

                                <i class="bi bi-check-circle-fill me-2"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background: #fff7f1;
    }

    .form-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ff6b1a;
    }

    .form-card {
        border-radius: 25px;
        box-shadow: 0 15px 45px rgba(0,0,0,.07);
    }

    .form-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#ff6b1a,#ff9a5a);
        color: white;
        font-size: 28px;
    }

    .form-label {
        font-weight: 600;
    }

    .custom-input {
        border-radius: 13px;
        overflow: hidden;
        border: 1px solid #eee;
    }

        .custom-input:focus-within {
            border-color: #ff8b4c;
            box-shadow: 0 0 0 .2rem rgba(255,107,26,.10);
        }

        .custom-input .input-group-text {
            border: none;
            background: #fff7f2;
            color: #ff6b1a;
        }

        .custom-input .form-control,
        .custom-input .form-select {
            border: none;
            min-height: 50px;
            box-shadow: none;
        }

    .btn-room-primary {
        background: linear-gradient(135deg,#ff6b1a,#ff944d);
        color: white;
        border: none;
        padding: 13px;
        border-radius: 13px;
        font-weight: 600;
    }

        .btn-room-primary:hover {
            color: white;
        }

    .btn-back,
    .btn-cancel {
        border: 1px solid #ddd;
        background: white;
        border-radius: 13px;
        padding: 12px 20px;
    }

    @@media(max-width: 576px) {

        .form-page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 20px;
        }
    }

    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
       
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}