@model Frontend.DTOs.RoomCreateModel
@{
    ViewData["Title"] = "Create Room";
    var camps = ViewBag.Camps as List<Frontend.DTOs.CampResponseModel>;
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card form-card border-0">
                <div class="card-body p-4">
                    <span class="section-badge">ROOM MANAGEMENT</span>
                    <h3 class="mt-2 mb-4">Add New Room</h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="CreateRoom" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="RoomNo" class="form-label fw-semibold"></label>
                            <input asp-for="RoomNo" class="form-control" type="number" required />
                            <span asp-validation-for="RoomNo" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CampId" class="form-label fw-semibold"></label>
                            <select asp-for="CampId" class="form-select" required>
                                <option value="">-- Select Camp --</option>
                                @if (camps != null)
                                {
                                    foreach (var c in camps)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CampId" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-room-primary w-100">Create Room</button>
                        <a asp-action="RoomList" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-card {
        border-radius: 24px;
        box-shadow: 0 12px 40px rgba(0,0,0,.05);
    }

    .section-badge {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #ff6b1a;
    }

    .btn-room-primary {
        background: linear-gradient(135deg, #ff6b1a, #ff944d);
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(255,107,26,.25);
    }

        .btn-room-primary:hover {
            color: white;
            transform: translateY(-2px);
        }


    html {
        overflow-x: hidden;
    }

    body {
        overflow-x: hidden;
    }

    img,
    svg,
    video,
    canvas {
        max-width: 100%;
        height: auto;
    }

    .container,
    .container-fluid {
        width: 100%;
    }

    .card,
    .shadow-sm,
    .shadow {
        max-width: 100%;
    }

    .form-control,
    .form-select,
    textarea,
    input {
        max-width: 100%;
    }

    .btn {
        white-space: normal;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .table-responsive > .table {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .table:not(.table-responsive .table) {
            min-width: 680px;
        }

        .table-responsive {
            margin-left: 0;
            margin-right: 0;
        }

        .display-1,
        .display-2,
        .display-3,
        .display-4 {
            font-size: calc(1.5rem + 2vw);
        }

        h1 {
            font-size: 1.75rem;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.25rem;
        }

        .row {
            --bs-gutter-x: 1rem;
        }

        .card-body {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .input-group {
            width: 100%;
        }

            .input-group .form-control,
            .input-group .form-select {
                min-width: 0;
            }

        .d-flex.gap-3 {
            gap: .75rem !important;
        }

        .btn {
            min-height: 44px;
        }
    }

    @@media (max-width: 575.98px) {
        .container,
        .container-fluid {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .card-body {
            padding: 1rem !important;
        }

        .form-control,
        .form-select {
            min-height: 46px;
        }

        .btn {
            width: 100%;
        }
      
        .d-flex.flex-row {
            flex-wrap: wrap;
        }

        .alert {
            overflow-wrap: anywhere;
        }

        .modal-dialog {
            margin: .5rem;
        }
    }

</style>
